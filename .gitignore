# Files git should NOT keep in history.

# Build output: cargo regenerates this; it gets to many gigabytes.
/target/

# IntelliJ's personal workspace state (window layout, open tabs).
.idea/workspace.xml
.idea/shelf/

# Worlds created while testing.
/worlds/

# Screenshots (F12 and self-tests).
/screenshots/

# Pictures exported from the World Gen suite.
/exports/

# Event logs (one per session; the newest 20 are kept).
/logs/
/worlds/

# Worlds baked by the Tectonic Sim (each is ~5 MB; its map.toml can bake it again).
/world bakes/

# The Registrar's undo steps: copies of the files a change touched, made before it.
/registrar undo/

# David's own notes on each section of the editor's panels: his, never committed.
/notes/

# The tools' window layout (Dear ImGui's state file).
imgui.ini

# Old Incus Artus, packed into old/ (plan 2.1): its build output, worlds, logs, screenshots, exports, bakes, undo
# steps, David's notes (old's frozen copy) and window layout, as above.
/old/target/
/old/worlds/
/old/logs/
/old/screenshots/
/old/exports/
/old/world bakes/
/old/registrar undo/
/old/notes/
/old/images/
